#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
{
    float physics:mass = 0.1
    float3 physics:diagonalInertia = (6.4e-05, 6.4e-05, 6.4e-05)
    def Sphere "geometry" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double radius = 0.04
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.25)]
    }
}
