#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
{
    float physics:mass = 0.1
    float3 physics:diagonalInertia = (0.0001066667, 0.0001066667, 0.0001066667)
    def Cube "geometry" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double size = 0.08
        color3f[] primvars:displayColor = [(0.85, 0.25, 0.12)]
    }
}
