#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"])
{
    float physics:mass = 0.1
    float3 physics:diagonalInertia = (0.0001139583, 0.0001139583, 6.125e-05)
    def Cylinder "geometry" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double radius = 0.035
        double height = 0.1
        uniform token axis = "Z"
        color3f[] primvars:displayColor = [(0.12, 0.55, 0.8)]
    }
}
